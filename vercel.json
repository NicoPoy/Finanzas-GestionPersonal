{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/finanzas",
      "destination": "/index.html"
    },
    {
      "source": "/finanzas/:path*",
      "destination": "/index.html"
    }
  ]
}
