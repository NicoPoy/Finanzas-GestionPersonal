{
  "name": "finanzas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:front": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "android:add": "cap add android",
    "android:assets": "capacitor-assets generate --android",
    "android:sync": "npm run build && cap sync android",
    "android:publish-apk": "powershell -NoProfile -Command \"Copy-Item -LiteralPath 'android\\app\\build\\outputs\\apk\\debug\\app-debug.apk' -Destination 'frontend\\public\\finanzas-debug.apk' -Force\"",
    "android:open": "cap open android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
